{
  "expo": {
    "name": "Recyc Caisse",
    "slug": "recyccaisse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "recyccaisse",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.groupemes.recyccaisse",
      "infoPlist": {
        "NSCameraUsageDescription": "Scanner le QR code d'un article de la vitrine.",
        "NSBluetoothAlwaysUsageDescription": "Se connecter au terminal de paiement.",
        "NSLocationWhenInUseUsageDescription": "Stripe exige la localisation pour encaisser au terminal."
      }
    },
    "android": {
      "package": "fr.groupemes.recyccaisse",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scanner le QR code d'un article de la vitrine.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Stripe exige la localisation pour encaisser au terminal."
        }
      ],
      [
        "@stripe/stripe-terminal-react-native",
        {
          "bluetoothBackgroundMode": true,
          "locationWhenInUsePermission": "Stripe exige la localisation pour encaisser au terminal.",
          "bluetoothPeripheralPermission": "Se connecter au terminal de paiement.",
          "bluetoothAlwaysUsagePermission": "Se connecter au terminal de paiement."
        }
      ],
      "expo-web-browser",
      "expo-build-properties"
    ],
    "extra": {
      "eas": {
        "projectId": "59b8ebd2-636e-4113-8ef7-afea455d785d"
      }
    },
    "owner": "frenchge"
  }
}
